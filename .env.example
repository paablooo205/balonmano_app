# Copia este archivo a .env.local y rellena con los datos de tu proyecto Supabase
# (Project Settings → API → Project URL / anon public key)
# OJO: VITE_SUPABASE_URL es solo "https://xxxx.supabase.co" — SIN /rest/v1/ ni ninguna
# ruta añadida. El cliente de supabase-js construye esas rutas internamente.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo necesarias para scripts de siembra locales (npm run seed:planificacion)
SEED_EMAIL=tu-email@ejemplo.com
SEED_PASSWORD=tu-contraseña
